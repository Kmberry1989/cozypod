{
  "name": "cozypod-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx --yes firebase-tools@14.27.0 emulators:exec --only database --project demo-cozypod \"vitest run src/database.rules.test.ts\"",
