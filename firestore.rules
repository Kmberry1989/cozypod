rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
    }
    match /catalog/{item} { allow read: if true; allow write: if false; }
    match /partyResults/{result} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerIds;
      allow write: if false;
    }
    match /rewardTransactions/{reward} { allow read, write: if false; }
  }
}
